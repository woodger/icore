{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noArguments": "error",
        "noBannedTypes": "error",
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noNamespace": "error",
        "useConst": "error",
        "useExportType": "off",
        "useSpreadOverApply": "error"
      },
      "suspicious": {
        "noConfusingVoidType": "off",
        "noExplicitAny": "error",
        "noUnusedExpressions": "error"
      }
    }
  },
  "assist": {
    "enabled": false
  }
}

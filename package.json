{
  "name": "icore",
  "version": "2.2.1",
  "description": "Typed CLI command mechanics for Node.js that keep argument parsing separate from application logic",
  "keywords": [
    "cli",
    "command-line",
    "flags",
    "typed-cli",
    "argv"
  ],
  "author": {
    "name": "Stanislav Potemkin",
    "email": "woodger@ya.ru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodger/icore.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": ">=16.9.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "test": "fwa --prune",
    "lint": "oxlint src && oxlint --config .oxlintrc.type-aware.json src"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "fwa": "^2.1.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}

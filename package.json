{
  "name": "icore",
  "version": "2.1.0",
  "description": "Dependency-free typed CLI command routing, option parsing, and terminal output mechanics for Node.js",
  "keywords": [
    "cli",
    "command-line",
    "typescript",
    "typed-cli",
    "declarative-cli",
    "argv",
    "argument-parser",
    "option-parser",
    "command-router",
    "command-registry",
    "command-aliases",
    "terminal-output",
    "dependency-free",
    "nodejs"
  ],
  "author": {
    "name": "Stanislav Potemkin",
    "email": "woodger@ya.ru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodger/icore.git"
  },
  "engines": {
    "node": ">=16.9.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "test": "fwa --prune",
    "lint": "biome lint src"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.0.1",
    "fwa": "^2.1.0",
    "typescript": "^7.0.2"
  }
}
